{
  "name": "beefchicken-mcp",
  "version": "0.2.0",
  "description": "Generates an MCP server from an OpenAPI specification, deployable on Cloudflare Workers and Node.js hosting.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "beefchicken-mcp": "bin/beefchicken-mcp.mjs"
  },
  "files": [
    "bin",
    "src/stdio.ts",
    "src/server.ts",
    "src/client.ts",
    "src/logging.ts",
    "src/tools/executor.ts",
    "scripts/generate-tools.ts"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Watanabebashi/BeefChicken-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Watanabebashi/BeefChicken-MCP/issues"
  },
  "homepage": "https://github.com/Watanabebashi/BeefChicken-MCP#readme",
  "author": "furu04 <133187748+furu04@users.noreply.github.com>",
  "scripts": {
    "generate": "tsx scripts/generate-tools.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "tsx src/node.ts",
    "node:dev": "tsx src/node.ts",
    "stdio": "tsx src/stdio.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.1",
    "tsx": "^4.19.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7",
    "wrangler": "^3.83.0"
  }
}
